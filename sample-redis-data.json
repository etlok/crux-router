{
  "workflow_definition": {
    "key": "workflow:create_entity",
    "data": {
      "id": "create_entity",
      "name": "Create Entity Workflow",
      "description": "Complete workflow for creating new entities in the system",
      "version": "1.0",
      "status": "active",
      "steps": [
        {
          "id": "validate_input",
          "name": "Validate Input Data",
          "type": "validation",
          "worker_type": "validation",
          "config": {
            "required_fields": ["name", "type", "attributes"],
            "validation_rules": {
              "name": {"min_length": 1, "max_length": 100},
              "type": {"allowed_values": ["user", "product", "order", "category"]},
              "attributes": {"type": "object"}
            }
          },
          "timeout_seconds": 30,
          "retry_policy": {
            "max_attempts": 3,
            "backoff_strategy": "exponential"
          },
          "next_step": "process_entity"
        },
        {
          "id": "process_entity",
          "name": "Process Entity Creation",
          "type": "processing", 
          "worker_type": "processing",
          "config": {
            "database_operation": "create",
            "table": "entities",
            "generate_id": true,
            "timestamps": true,
            "audit_log": true
          },
          "timeout_seconds": 60,
          "retry_policy": {
            "max_attempts": 2,
            "backoff_strategy": "linear"
          },
          "next_step": "notify_completion"
        },
        {
          "id": "notify_completion",
          "name": "Send Completion Notification",
          "type": "notification",
          "worker_type": "notification", 
          "config": {
            "notification_type": "websocket",
            "channels": ["entity_created", "admin_notifications"],
            "include_entity_data": true,
            "email_notification": false
          },
          "timeout_seconds": 15,
          "retry_policy": {
            "max_attempts": 3,
            "backoff_strategy": "exponential"
          },
          "next_step": null
        }
      ],
      "created_at": "2025-10-15T10:30:00Z",
      "updated_at": "2025-10-15T10:30:00Z"
    }
  },
